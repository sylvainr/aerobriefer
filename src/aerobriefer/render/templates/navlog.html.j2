<meta charset="utf-8">
<title>Navlog {{ origin }} → {{ destination }}</title>
<style>
  @page { size: A4 portrait; margin: 8mm 6mm 11mm 6mm;
    @bottom-left  { content: "{{ page_footer }}"; font: 6pt Arial, sans-serif; color: #555; }
    @bottom-right { content: "page " counter(page) " / " counter(pages); font: 6pt Arial, sans-serif; color: #555; }
  }
  html { font-size: 9pt; }
  body { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; color: #000; background: #fff; margin: 0; line-height: 1.15; }
  /* À l'écran : plus large et confortable ; la table déborde en scroll horizontal
     plutôt que de chevaucher si l'écran est étroit. */
  @media screen { html { background: #ececec; } body { max-width: 1200px; margin: 18px auto; padding: 16px 22px; box-shadow: 0 1px 6px rgba(0,0,0,.15); overflow-x: auto; } }

  h1 { font-size: 11.5pt; margin: 0 0 1.5mm; color: #12232e; letter-spacing: .3px; }
  .facts { display: flex; flex-wrap: wrap; gap: .8mm 4mm; margin: 0 0 2mm; font-size: 7pt; }
  .fact b { display: block; font-size: 5.5pt; text-transform: uppercase; letter-spacing: .3px; color: #555; font-weight: 600; }
  .mono { font-family: "SF Mono", Menlo, Consolas, monospace; }

  table { width: 100%; border-collapse: collapse; font-size: 6.6pt; table-layout: fixed; }
  th, td { border: .5pt solid #888; padding: 1mm 0.8mm; vertical-align: top; overflow-wrap: break-word; word-break: break-word; }
  th { background: #12232e; color: #fff; font-size: 5.6pt; text-transform: uppercase; letter-spacing: .2px; text-align: center; padding: 1mm 0.4mm; }
  td { height: 14mm; }
  .c { text-align: center; }
  .big { font-size: 9.5pt; font-weight: 700; }
  .sub { font-size: 5.8pt; color: #444; }
  .auto { font-size: 6.2pt; color: #12232e; }
  .auto b { color: #2b6cb0; }
  .arrow { font-size: 9pt; font-weight: 700; }
  .nw { white-space: nowrap; }               /* groupes valeur+unité insécables */
  .lr { font-weight: 700; color: #12232e; }  /* flèche compacte gauche/droite (◀/▶) */
  /* Petite icône « vent » (lignes d'air), SVG inline — remplace le mot « Vent ». */
  .wico { display: inline-block; width: .95em; height: .95em; vertical-align: -0.12em;
    background: no-repeat center/contain url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="%2312232e" stroke-width="2.2" stroke-linecap="round"><path d="M2 9h11a2.6 2.6 0 1 0-2.6-2.6"/><path d="M2 14h15a2.6 2.6 0 1 1-2.6 2.6"/></svg>'); }
  .qfu { font-size: 7.4pt; font-weight: 700; color: #12232e; background: #d6ecd9; padding: 0.4mm 1mm; border-radius: 0.6mm; margin: 0.5mm 0; }
  .qfu b { font-size: 8.5pt; }
  /* Colonne Branche : verticale (départ ↓ arrivée), avec le nom du terrain. */
  .branche { text-align: left; }
  .branche .b { font-size: 8.5pt; font-weight: 700; }
  .branche .down { color: #888; font-size: 8pt; line-height: 1; margin: 0.3mm 0; }
  /* Radios en TABLE alignée : libellé à gauche, fréquence à droite (mono). */
  table.radiotbl { width: 100%; border-collapse: collapse; }
  table.radiotbl td { height: auto; border: 0; padding: 0 0 0.3mm 0; vertical-align: top; font-size: 6.4pt; }
  .radiotbl .rlabel { font-weight: 700; padding-right: 1.5mm; }
  .radiotbl .rfreq { text-align: right; white-space: nowrap; font-family: "SF Mono", Menlo, Consolas, monospace; }
  .morse { font-family: "SF Mono", Menlo, Consolas, monospace; font-size: 5pt; letter-spacing: -0.3px; color: #2b6cb0; }
  th.big-h { font-size: 8pt; background: #35618e; }
  .lbl { font-size: 5.3pt; color: #888; text-transform: uppercase; letter-spacing: .3px; }
  .blank { display: block; border-bottom: .5pt solid #bbb; height: 3mm; }
  th.fill { background: #35618e; }
  .go { color: #1f6b3a; font-weight: 700; }
  .nogo { color: #b3261e; font-weight: 700; }
  tbody tr:nth-child(even) td { background: #fbfbfb; }
  .totals td { height: auto; font-weight: 700; background: #f0f0f0; border-top: 1.4pt solid #000; }
  td a { color: #2b6cb0; text-decoration: none; }
  /* Mini-table (vents) : lignes compactes, pas la hauteur d'écriture du navlog. */
  table.mini { font-size: 7pt; margin-bottom: 1mm; }
  table.mini td, table.mini th { height: auto; padding: 0.7mm 1.5mm; }

  .vac { margin-top: 2.5mm; font-size: 7pt; }
  .vac b { font-size: 6pt; text-transform: uppercase; letter-spacing: .3px; color: #555; }
  .vac a { color: #2b6cb0; text-decoration: none; }
  .disclaimer { margin-top: 2mm; padding-top: 1.5mm; border-top: 1pt solid #000; font-size: 6.5pt; color: #333; }
  .disclaimer b { color: #b3261e; }
</style>

<h1>LOG DE NAVIGATION — {{ origin }} → {{ destination }}</h1>
<div class="facts">
  <div class="fact"><b>Aéronef</b><span class="mono">{{ aircraft_name }}</span></div>
  <div class="fact"><b>Départ prévu</b><span class="mono">{{ departure_dual }}</span></div>
  <div class="fact"><b>TAS</b><span class="mono">{{ tas }}</span></div>
  <div class="fact"><b>Conso</b><span class="mono">{{ fuel_flow_lph }} L/h</span></div>
  <div class="fact"><b>Décl.</b><span class="mono">{{ mag_var_label }}</span></div>
  <div class="fact"><b>Total</b><span class="mono">{{ total_distance }} NM · {{ total_time }} · {{ total_fuel }}</span></div>
</div>

<table>
  <colgroup>
    <col style="width:9%"><col style="width:6%"><col style="width:9%"><col style="width:6%">
    <col style="width:5%"><col style="width:5%"><col style="width:6%"><col style="width:6%">
    <col style="width:25%"><col style="width:23%">
  </colgroup>
  <thead>
    <tr>
      <th class="left">Branche</th>
      <th>Alt / Zmin</th>
      <th>RM <span style="font-weight:400">(Rv·Dv)</span></th>
      <th>Dist</th>
      <th>Temps</th>
      <th>Conso</th>
      <th class="fill big-h">HE</th>
      <th class="fill big-h">HR</th>
      <th>Radios <span style="font-weight:400">(MHz) · VOR · notes</span></th>
      <th>Déroutement</th>
    </tr>
  </thead>
  <tbody>
    {% for r in rows %}
    <tr>
      <td class="branche">
        <div class="mono b">{% if r.from.url %}<a href="{{ r.from.url }}">{{ r.from.code }}</a>{% else %}{{ r.from.code }}{% endif %}</div>
        {% if r.from.name %}<div class="sub">{{ r.from.name }}</div>{% endif %}
        <div class="down">↓</div>
        <div class="mono b">{% if r.to.url %}<a href="{{ r.to.url }}">{{ r.to.code }}</a>{% else %}{{ r.to.code }}{% endif %}</div>
        {% if r.to.name %}<div class="sub">{{ r.to.name }}</div>{% endif %}
      </td>
      <td class="c">
        <span class="big">{{ r.altitude }}</span><span class="sub"> ft</span>
        {% if r.zmin %}<div class="auto"><span class="lbl">Zmin</span> <b>{{ r.zmin }} ft</b></div>{% else %}<span class="lbl">Zmin</span><span class="blank"></span>{% endif %}
      </td>
      <td class="c">
        <span class="big">{{ r.magnetic_heading }}°</span>
        <div class="sub"><span class="nw">Rv {{ r.true_track }}°</span> · <span class="nw">Dv {{ r.drift }}</span></div>
        <div class="sub"><span class="nw">{{ r.wind }}</span> · <span class="nw">Vs {{ r.ground_speed }}</span></div>
      </td>
      <td class="c"><span class="big">{{ r.distance }}</span> <span class="sub">NM</span><div class="sub"><span class="nw">cum {{ r.cumulative }} NM</span><br><span class="nw">DTG {{ r.dtg }} NM</span></div></td>
      <td class="c"><span class="big">{{ r.tav }}</span> <span class="sub">min</span><div class="sub"><span class="nw">svt {{ r.tsv }} min</span></div></td>
      <td class="c"><span class="big">{{ r.fuel }}</span> <span class="sub">L</span><div class="sub"><span class="nw">cum {{ r.fuel_cumulative }} L</span></div></td>
      <td class="fill"></td>
      <td class="fill"></td>
      <td class="auto">
        {% if r.radios %}<table class="radiotbl">
          {% for radio in r.radios %}<tr><td class="rlabel">{{ radio.label }}</td><td class="rfreq">{{ radio.freq }}</td></tr>{% endfor %}
        </table>{% endif %}
        {% if r.vor %}<div class="sub" style="margin-top:0.6mm">VOR {{ r.vor.ident }} <span class="morse">{{ r.vor.morse }}</span> <span class="nw">{{ r.vor.freq }}</span> <span class="nw">R{{ r.vor.radial }}°</span> <span class="nw">{{ r.vor.distance }} NM</span></div>{% endif %}
        <span class="blank"></span><span class="blank"></span>
      </td>
      <td class="auto">
        {% if r.diversion %}
        <div><a href="{{ r.diversion.url }}"><b>{{ r.diversion.icao }}</b></a> <span class="sub">{{ r.diversion.name }}</span></div>
        <div><span class="nw"><span class="lr">{{ r.diversion.dir_arrow }}</span> <b>{{ r.diversion.relative }}</b></span> · <span class="nw">{{ r.diversion.distance }} NM</span> · <span class="nw">{{ r.diversion.time_min }} min</span></div>
        {% if r.diversion.wind %}<div class="sub"><span class="nw"><span class="wico" title="vent"></span> {{ r.diversion.wind }}</span>{% if r.diversion.headwind is not none %} · <span class="nw">{% if r.diversion.headwind >= 0 %}face {{ r.diversion.headwind }}{% else %}arr. {{ -r.diversion.headwind }}{% endif %} kt</span> · <span class="nw">trav {{ r.diversion.crosswind }} kt {{ r.diversion.xwind_arrow }}</span>{% endif %}</div>{% endif %}
        {% if r.diversion.favoured_qfu %}<div class="qfu"><span class="nw">QFU <b>{{ r.diversion.favoured_qfu }}</b></span> · <span class="nw">{{ r.diversion.favoured_length_m }} m</span>{% if r.diversion.favoured_required_m %} · <span class="nw">atterro {{ r.diversion.favoured_required_m }} m {% if r.diversion.favoured_ok %}<span class="go">✓</span>{% else %}<span class="nogo">✗</span>{% endif %}</span>{% endif %}</div>{% endif %}
        {% if r.diversion.runways|length > 1 %}<div class="sub">autres pistes : {% for rw in r.diversion.runways %}{% if not rw.favoured %}<span class="nw">{{ rw.ident }} {{ rw.length_m }} m</span>{% if not loop.last %} · {% endif %}{% endif %}{% endfor %}</div>{% endif %}
        {% else %}<span class="sub">—</span>{% endif %}
      </td>
    </tr>
    {% endfor %}
    <tr class="totals">
      <td>TOTAL</td>
      <td class="c">—</td>
      <td class="c">—</td>
      <td class="c">{{ total_distance }} NM</td>
      <td class="c">{{ total_time }}</td>
      <td class="c">{{ total_fuel }}</td>
      <td class="fill"></td>
      <td class="fill"></td>
      <td class="c" colspan="2">—</td>
    </tr>
  </tbody>
</table>

{% if winds %}
<p class="vac" style="margin-bottom:1mm"><b>Vent en altitude considéré</b> <span class="sub">— source {{ winds_caption }}</span></p>
<table class="mini">
  <thead><tr><th class="left">Branche</th><th>Altitude</th><th><span class="wico"></span> (provenance° / force kt)</th></tr></thead>
  <tbody>
    {% for w in winds %}
    <tr><td class="left mono">{{ w.branch }}</td><td class="c mono">{{ w.altitude }} ft</td><td class="c mono">{{ w.from_deg }}° / {{ w.speed_kt }} kt</td></tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

{% if perfs %}
<p class="vac"><b>Perfs piste</b> <span class="sub">(conditions conservatrices : masse maxi, ISA+15, sans vent)</span> —
  {% for p in perfs %}{{ p.label }} {{ p.runway }} : requis {{ p.required }} m / dispo {{ p.available }} m
  ({% if p.ok %}<span class="go">GO {{ p.margin_pct }} %</span>{% else %}<span class="nogo">NO-GO {{ p.margin_pct }} %</span>{% endif %}){% if not loop.last %} · {% endif %}{% endfor %}.
</p>
{% endif %}

{% if fuel_plan %}
<p class="vac"><b>Bilan carburant</b> —
  roulage {{ fuel_plan.taxi }} L · trajet {{ fuel_plan.trip }} L{% if fuel_plan.alternate != '0.0' %} · dégagement {{ fuel_plan.alternate }} L{% endif %} · réserve 30 min {{ fuel_plan.reserve }} L
  = <b>minimum {{ fuel_plan.total }} L</b> · capacité {{ fuel_plan.capacity }} L ·
  {% if fuel_plan.sufficient %}marge {{ fuel_plan.margin }} L{% else %}<span class="nogo">INSUFFISANT ({{ fuel_plan.margin }} L)</span>{% endif %}
  · endurance {{ fuel_plan.endurance }}.
</p>
{% endif %}

{% if vac_links %}
<p class="vac"><b>Cartes VAC (SIA)</b> —
  {% for v in vac_links %}<a href="{{ v.url }}">{{ v.icao }}</a>{% if v.name %} ({{ v.name }}){% endif %}{% if not loop.last %} · {% endif %}{% endfor %}.
  Visualisateur : <a href="https://www.sia.aviation-civile.gouv.fr/vaip">vAIP SIA</a>.
</p>
{% endif %}

<p class="disclaimer">
  <b>AIDE À LA PRÉPARATION — ne remplace pas le calcul officiel ni le jugement du commandant de bord.</b>
  HE/HR = heure estimée / réelle, à remplir. <b>RM = Rv − déclinaison</b> ({{ mag_var_label }}, à confirmer sur la carte).
  Dist : DI branche, cumul, DTG restante. Temps : avec vent (svt = sans vent). Radios : terrains + espaces traversés (étiquetés).
  VOR (secondaire) : ident + Morse + radiale. Déroutement = terrain le plus proche, direction RELATIVE à la route (flèche + G/D de X°),
  avec sa piste et la marge d'atterrissage DR400.
  Vent : <b>Open-Meteo</b> (GFS/ARPEGE), à l'heure de départ.
  Zmin = relief max du couloir + 1000 ft (Open-Meteo/SRTM, <b>terrain seul</b>).
  Généré le {{ generated_dual }}.
</p>
