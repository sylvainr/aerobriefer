<meta charset="utf-8">
<title>Navlog {{ origin }} → {{ destination }}</title>
<style>
  @page { size: A4 portrait; margin: 8mm 7mm 11mm 7mm;
    @bottom-left  { content: "{{ page_footer }}"; font: 6pt Arial, sans-serif; color: #555; }
    @bottom-right { content: "page " counter(page) " / " counter(pages); font: 6pt Arial, sans-serif; color: #555; }
  }
  html { font-size: 9pt; }
  body { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; color: #000; background: #fff; margin: 0; line-height: 1.2; }
  @media screen { html { background: #ececec; } body { max-width: 900px; margin: 18px auto; padding: 16px 18px; box-shadow: 0 1px 6px rgba(0,0,0,.15); } }

  h1 { font-size: 11.5pt; margin: 0 0 1.5mm; color: #12232e; letter-spacing: .3px; }
  .facts { display: flex; flex-wrap: wrap; gap: .8mm 4mm; margin: 0 0 2mm; font-size: 7pt; }
  .fact b { display: block; font-size: 5.5pt; text-transform: uppercase; letter-spacing: .3px; color: #555; font-weight: 600; }
  .mono { font-family: "SF Mono", Menlo, Consolas, monospace; }

  table { width: 100%; border-collapse: collapse; font-size: 6.8pt; table-layout: fixed; }
  th, td { border: .5pt solid #888; padding: 1mm 1mm; vertical-align: top; }
  th { background: #12232e; color: #fff; font-size: 5.8pt; text-transform: uppercase; letter-spacing: .2px; text-align: center; padding: 1mm 0.5mm; }
  td { height: 13mm; }
  .c { text-align: center; }
  .big { font-size: 10pt; font-weight: 700; }
  .sub { font-size: 6pt; color: #444; }
  .auto { font-size: 6.3pt; color: #12232e; }
  .auto b { color: #2b6cb0; }
  .lbl { font-size: 5.5pt; color: #888; text-transform: uppercase; letter-spacing: .3px; }
  .blank { display: block; border-bottom: .5pt solid #bbb; height: 3mm; }
  th.fill { background: #35618e; }
  .eto b { font-size: 8.5pt; }
  tbody tr:nth-child(even) td { background: #fbfbfb; }
  .totals td { height: auto; font-weight: 700; background: #f0f0f0; border-top: 1.4pt solid #000; }

  .vac { margin-top: 2.5mm; font-size: 7pt; }
  .vac b { font-size: 6pt; text-transform: uppercase; letter-spacing: .3px; color: #555; }
  .vac a { color: #2b6cb0; text-decoration: none; }
  .disclaimer { margin-top: 2mm; padding-top: 1.5mm; border-top: 1pt solid #000; font-size: 6.5pt; color: #333; }
  .disclaimer b { color: #b3261e; }
</style>

<h1>LOG DE NAVIGATION — {{ origin }} → {{ destination }}</h1>
<div class="facts">
  <div class="fact"><b>Aéronef</b><span class="mono">{{ aircraft_name }}</span></div>
  <div class="fact"><b>Départ prévu</b><span class="mono">{{ departure_dual }}</span></div>
  <div class="fact"><b>Arrivée est.</b><span class="mono">{{ arrival_dual }}</span></div>
  <div class="fact"><b>TAS</b><span class="mono">{{ tas_kt }} kt</span></div>
  <div class="fact"><b>Conso</b><span class="mono">{{ fuel_flow_lph }} L/h</span></div>
  <div class="fact"><b>Décl.</b><span class="mono">{{ mag_var_label }}</span></div>
  <div class="fact"><b>Total</b><span class="mono">{{ total_distance }} NM · {{ total_time }} · {{ total_fuel }}</span></div>
</div>

<table>
  <colgroup>
    <col style="width:14%"><col style="width:10%"><col style="width:12%"><col style="width:16%">
    <col style="width:11%"><col style="width:25%"><col style="width:12%">
  </colgroup>
  <thead>
    <tr>
      <th class="left">Branche</th>
      <th>Alt / Zmin</th>
      <th>RM <span style="font-weight:400">(Rv·Dv)</span></th>
      <th>Dist / Temps / Conso</th>
      <th class="fill">Heures</th>
      <th>Observations <span style="font-weight:400">(VOR · radios)</span></th>
      <th>Déroutement</th>
    </tr>
  </thead>
  <tbody>
    {% for r in rows %}
    <tr>
      <td class="mono">{{ r.branch }}</td>
      <td class="c">
        <span class="big">{{ r.altitude }}</span><span class="sub"> ft</span>
        {% if r.zmin %}<div class="auto"><span class="lbl">Zmin</span> <b>{{ r.zmin }} ft</b></div>{% else %}<span class="lbl">Zmin</span><span class="blank"></span>{% endif %}
      </td>
      <td class="c">
        <span class="big">{{ r.magnetic_heading }}°</span>
        <div class="sub">Rv {{ r.true_track }} · Dv {{ r.drift }}</div>
        <div class="sub">{{ r.wind }} · Vs {{ r.ground_speed }}</div>
      </td>
      <td class="c">
        <div><b>DI</b> {{ r.distance }} <span class="sub">NM</span> · DTG {{ r.dtg }}</div>
        <div class="sub">cumul {{ r.cumulative }} NM · Tsv {{ r.tsv }}′ · Tav {{ r.tav }}′</div>
        <div class="sub">Conso {{ r.fuel }} L · cum {{ r.fuel_cumulative }} L</div>
      </td>
      <td>
        <div class="eto"><span class="lbl">Est.</span> <b>{{ r.eto_local }}</b> <span class="sub">{{ r.eto_zulu }}</span></div>
        <span class="lbl">Réel</span><span class="blank"></span>
      </td>
      <td class="auto">
        {% if r.vor %}<div>VOR <b>{{ r.vor }}</b></div>{% endif %}
        {% if r.radios %}<div>{{ r.radios }}</div>{% endif %}
        {% if not r.vor and not r.radios %}<span class="sub">—</span>{% endif %}
      </td>
      <td class="auto">{% if r.diversion %}{{ r.diversion }}{% else %}<span class="sub">—</span>{% endif %}</td>
    </tr>
    {% endfor %}
    <tr class="totals">
      <td>TOTAL</td>
      <td class="c">—</td>
      <td class="c">—</td>
      <td class="c">{{ total_distance }} NM · {{ total_time }} · {{ total_fuel }}</td>
      <td><span class="lbl">Arrivée</span> <b>{{ arrival_local }}</b></td>
      <td class="c" colspan="2">—</td>
    </tr>
  </tbody>
</table>

{% if perfs %}
<p class="vac"><b>Perfs piste</b> <span class="sub">(conditions conservatrices : masse maxi, ISA+15, sans vent)</span> —
  {% for p in perfs %}{{ p.label }} {{ p.runway }} : requis {{ p.required }} m / dispo {{ p.available }} m
  ({% if p.ok %}<b style="color:#1f6b3a">GO {{ p.margin_pct }} %</b>{% else %}<b style="color:#b3261e">NO-GO {{ p.margin_pct }} %</b>{% endif %}){% if not loop.last %} · {% endif %}{% endfor %}.
</p>
{% endif %}

{% if fuel_plan %}
<p class="vac"><b>Bilan carburant</b> —
  roulage {{ fuel_plan.taxi }} L · trajet {{ fuel_plan.trip }} L{% if fuel_plan.alternate != '0.0' %} · dégagement {{ fuel_plan.alternate }} L{% endif %} · réserve 30 min {{ fuel_plan.reserve }} L
  = <b>minimum {{ fuel_plan.total }} L</b> · capacité {{ fuel_plan.capacity }} L ·
  {% if fuel_plan.sufficient %}marge {{ fuel_plan.margin }} L{% else %}<b style="color:#b3261e">INSUFFISANT ({{ fuel_plan.margin }} L)</b>{% endif %}
  · endurance {{ fuel_plan.endurance }}.
  <span style="color:#b3261e">Conso provisoire (avion fictif).</span>
</p>
{% endif %}

{% if vac_links %}
<p class="vac"><b>Cartes VAC (SIA)</b> —
  {% for v in vac_links %}<a href="{{ v.url }}">{{ v.icao }}</a>{% if v.name %} ({{ v.name }}){% endif %}{% if not loop.last %} · {% endif %}{% endfor %}.
  Visualisateur : <a href="https://www.sia.aviation-civile.gouv.fr/vaip">vAIP SIA</a>.
</p>
{% endif %}

<p class="disclaimer">
  <b>AIDE À LA PRÉPARATION — ne remplace pas le calcul officiel ni le jugement du commandant de bord.</b>
  <b>RM = Rv − déclinaison</b> ({{ mag_var_label }}, à confirmer sur la carte). DI = distance de branche, DTG = distance restante,
  Tsv/Tav = temps sans / avec vent. VOR = radiale magnétique depuis le VOR le plus proche vers le point ; déroutement = terrain le plus proche.
  Vent en altitude interpolé — source <b>Open-Meteo</b> (GFS/ARPEGE), à l'heure de départ.
  <b>TAS et conso PROVISOIRES</b> (valeurs typiques DR400/160, avion d'exemple F-ZZZZ fictif).
  Zmin = relief max du couloir + 1000 ft (Open-Meteo/SRTM, <b>terrain seul</b> — obstacles ponctuels à vérifier NOTAM/VAC).
  Heures locales = {{ display_timezone }}, Z indiqué. Généré le {{ generated_dual }}.
</p>
