<meta charset="utf-8">
<title>Navlog {{ origin }} → {{ destination }}</title>
<style>
  @page { size: A4 portrait; margin: 8mm 6mm 11mm 6mm;
    @bottom-left  { content: "{{ page_footer }}"; font: 6pt Arial, sans-serif; color: #555; }
    @bottom-right { content: "page " counter(page) " / " counter(pages); font: 6pt Arial, sans-serif; color: #555; }
  }
  html { font-size: 9pt; }
  body { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; color: #000; background: #fff; margin: 0; line-height: 1.15; }
  @media screen { html { background: #ececec; } body { max-width: 940px; margin: 18px auto; padding: 16px 18px; box-shadow: 0 1px 6px rgba(0,0,0,.15); } }

  h1 { font-size: 11.5pt; margin: 0 0 1.5mm; color: #12232e; letter-spacing: .3px; }
  .facts { display: flex; flex-wrap: wrap; gap: .8mm 4mm; margin: 0 0 2mm; font-size: 7pt; }
  .fact b { display: block; font-size: 5.5pt; text-transform: uppercase; letter-spacing: .3px; color: #555; font-weight: 600; }
  .mono { font-family: "SF Mono", Menlo, Consolas, monospace; }

  table { width: 100%; border-collapse: collapse; font-size: 6.6pt; table-layout: fixed; }
  th, td { border: .5pt solid #888; padding: 1mm 0.8mm; vertical-align: top; }
  th { background: #12232e; color: #fff; font-size: 5.6pt; text-transform: uppercase; letter-spacing: .2px; text-align: center; padding: 1mm 0.4mm; }
  td { height: 14mm; }
  .c { text-align: center; }
  .big { font-size: 9.5pt; font-weight: 700; }
  .sub { font-size: 5.8pt; color: #444; }
  .auto { font-size: 6.2pt; color: #12232e; }
  .auto b { color: #2b6cb0; }
  .arrow { font-size: 9pt; font-weight: 700; }
  .lbl { font-size: 5.3pt; color: #888; text-transform: uppercase; letter-spacing: .3px; }
  .blank { display: block; border-bottom: .5pt solid #bbb; height: 3mm; }
  th.fill { background: #35618e; }
  .go { color: #1f6b3a; font-weight: 700; }
  .nogo { color: #b3261e; font-weight: 700; }
  tbody tr:nth-child(even) td { background: #fbfbfb; }
  .totals td { height: auto; font-weight: 700; background: #f0f0f0; border-top: 1.4pt solid #000; }

  .vac { margin-top: 2.5mm; font-size: 7pt; }
  .vac b { font-size: 6pt; text-transform: uppercase; letter-spacing: .3px; color: #555; }
  .vac a { color: #2b6cb0; text-decoration: none; }
  .disclaimer { margin-top: 2mm; padding-top: 1.5mm; border-top: 1pt solid #000; font-size: 6.5pt; color: #333; }
  .disclaimer b { color: #b3261e; }
</style>

<h1>LOG DE NAVIGATION — {{ origin }} → {{ destination }}</h1>
<div class="facts">
  <div class="fact"><b>Aéronef</b><span class="mono">{{ aircraft_name }}</span></div>
  <div class="fact"><b>Départ prévu</b><span class="mono">{{ departure_dual }}</span></div>
  <div class="fact"><b>TAS</b><span class="mono">{{ tas_kt }} kt</span></div>
  <div class="fact"><b>Conso</b><span class="mono">{{ fuel_flow_lph }} L/h</span></div>
  <div class="fact"><b>Décl.</b><span class="mono">{{ mag_var_label }}</span></div>
  <div class="fact"><b>Total</b><span class="mono">{{ total_distance }} NM · {{ total_time }} · {{ total_fuel }}</span></div>
</div>

<table>
  <colgroup>
    <col style="width:12%"><col style="width:9%"><col style="width:10%"><col style="width:7%">
    <col style="width:7%"><col style="width:7%"><col style="width:5%"><col style="width:5%">
    <col style="width:16%"><col style="width:22%">
  </colgroup>
  <thead>
    <tr>
      <th class="left">Branche</th>
      <th>Alt / Zmin</th>
      <th>RM <span style="font-weight:400">(Rv·Dv)</span></th>
      <th>Dist</th>
      <th>Temps</th>
      <th>Conso</th>
      <th class="fill">HE</th>
      <th class="fill">HR</th>
      <th>Observations <span style="font-weight:400">(VOR·radios)</span></th>
      <th>Déroutement</th>
    </tr>
  </thead>
  <tbody>
    {% for r in rows %}
    <tr>
      <td class="mono">{{ r.branch }}</td>
      <td class="c">
        <span class="big">{{ r.altitude }}</span><span class="sub"> ft</span>
        {% if r.zmin %}<div class="auto"><span class="lbl">Zmin</span> <b>{{ r.zmin }}</b></div>{% else %}<span class="lbl">Zmin</span><span class="blank"></span>{% endif %}
      </td>
      <td class="c">
        <span class="big">{{ r.magnetic_heading }}°</span>
        <div class="sub">Rv {{ r.true_track }} · Dv {{ r.drift }}</div>
        <div class="sub">{{ r.wind }} · Vs {{ r.ground_speed }}</div>
      </td>
      <td class="c"><span class="big">{{ r.distance }}</span><div class="sub">cum {{ r.cumulative }}<br>DTG {{ r.dtg }}</div></td>
      <td class="c"><span class="big">{{ r.tav }}′</span><div class="sub">svt {{ r.tsv }}′</div></td>
      <td class="c"><span class="big">{{ r.fuel }}</span><div class="sub">cum {{ r.fuel_cumulative }}</div></td>
      <td class="fill"></td>
      <td class="fill"></td>
      <td class="auto">
        {% if r.vor %}<div>VOR <b>{{ r.vor }}</b></div>{% endif %}
        {% if r.radios %}<div>{{ r.radios }}</div>{% endif %}
        {% if not r.vor and not r.radios %}<span class="sub">—</span>{% endif %}
      </td>
      <td class="auto">
        {% if r.diversion %}
        <div><b>{{ r.diversion.icao }}</b> <span class="arrow">{{ r.diversion.arrow }}</span> {{ r.diversion.distance }} NM / {{ r.diversion.bearing }}°</div>
        {% if r.diversion.runway %}<div class="sub">piste {{ r.diversion.runway }}</div>{% endif %}
        {% if r.diversion.required %}<div class="sub">atterro {{ r.diversion.required }} m ·
          {% if r.diversion.ok %}<span class="go">marge {{ r.diversion.margin_pct }} %</span>{% else %}<span class="nogo">{{ r.diversion.margin_pct }} %</span>{% endif %}</div>{% endif %}
        {% else %}<span class="sub">—</span>{% endif %}
      </td>
    </tr>
    {% endfor %}
    <tr class="totals">
      <td>TOTAL</td>
      <td class="c">—</td>
      <td class="c">—</td>
      <td class="c">{{ total_distance }}</td>
      <td class="c">{{ total_time }}</td>
      <td class="c">{{ total_fuel }}</td>
      <td class="fill"></td>
      <td class="fill"></td>
      <td class="c" colspan="2">—</td>
    </tr>
  </tbody>
</table>

{% if perfs %}
<p class="vac"><b>Perfs piste</b> <span class="sub">(conditions conservatrices : masse maxi, ISA+15, sans vent)</span> —
  {% for p in perfs %}{{ p.label }} {{ p.runway }} : requis {{ p.required }} m / dispo {{ p.available }} m
  ({% if p.ok %}<span class="go">GO {{ p.margin_pct }} %</span>{% else %}<span class="nogo">NO-GO {{ p.margin_pct }} %</span>{% endif %}){% if not loop.last %} · {% endif %}{% endfor %}.
</p>
{% endif %}

{% if fuel_plan %}
<p class="vac"><b>Bilan carburant</b> —
  roulage {{ fuel_plan.taxi }} L · trajet {{ fuel_plan.trip }} L{% if fuel_plan.alternate != '0.0' %} · dégagement {{ fuel_plan.alternate }} L{% endif %} · réserve 30 min {{ fuel_plan.reserve }} L
  = <b>minimum {{ fuel_plan.total }} L</b> · capacité {{ fuel_plan.capacity }} L ·
  {% if fuel_plan.sufficient %}marge {{ fuel_plan.margin }} L{% else %}<span class="nogo">INSUFFISANT ({{ fuel_plan.margin }} L)</span>{% endif %}
  · endurance {{ fuel_plan.endurance }}. <span class="nogo">Conso provisoire (avion fictif).</span>
</p>
{% endif %}

{% if vac_links %}
<p class="vac"><b>Cartes VAC (SIA)</b> —
  {% for v in vac_links %}<a href="{{ v.url }}">{{ v.icao }}</a>{% if v.name %} ({{ v.name }}){% endif %}{% if not loop.last %} · {% endif %}{% endfor %}.
  Visualisateur : <a href="https://www.sia.aviation-civile.gouv.fr/vaip">vAIP SIA</a>.
</p>
{% endif %}

<p class="disclaimer">
  <b>AIDE À LA PRÉPARATION — ne remplace pas le calcul officiel ni le jugement du commandant de bord.</b>
  HE/HR = heure estimée / réelle, à remplir. <b>RM = Rv − déclinaison</b> ({{ mag_var_label }}, à confirmer sur la carte).
  Dist : DI branche, cumul, DTG restante. Temps : avec vent (svt = sans vent). VOR = radiale magnétique du VOR le plus proche.
  Déroutement = terrain le plus proche (flèche = cap), avec sa piste et la marge d'atterrissage DR400.
  Vent : <b>Open-Meteo</b> (GFS/ARPEGE), à l'heure de départ. <b>TAS/conso PROVISOIRES</b> (avion fictif F-ZZZZ).
  Zmin = relief max du couloir + 1000 ft (Open-Meteo/SRTM, <b>terrain seul</b>).
  Généré le {{ generated_dual }}.
</p>
