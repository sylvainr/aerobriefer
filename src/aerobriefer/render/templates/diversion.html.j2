<title>{{ view.doc_label }}{% if view.reference_icaos %} — {{ view.reference_icaos | join(' / ') }}{% endif %}</title>
<style>
  :root { --ink:#12232e; --ink-soft:#425466; --line:#c9d2db; --accent:#2b6cb0; }
  * { box-sizing: border-box; }
  body { font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--ink); font-size: 11pt; line-height: 1.35; margin: 0; padding: 8mm 9mm; }
  h1 { font-size: 17pt; margin: 0; letter-spacing: .3px; }
  h2 { font-size: 12pt; text-transform: uppercase; letter-spacing: 1px;
    border-bottom: 1.2pt solid #000; padding-bottom: 1mm; margin: 7mm 0 2mm; }
  h3 { font-size: 11pt; margin: 0; }
  p { margin: 0 0 1.5mm; }
  .mono { font-family: "SF Mono", Menlo, Consolas, monospace; }
  .small { font-size: 8.5pt; }
  .muted { color: var(--ink-soft); }
  a { color: var(--accent); }

  .head { border-bottom: 2pt solid #000; padding-bottom: 3mm; margin-bottom: 3mm;
    display: flex; justify-content: space-between; align-items: flex-start; gap: 8mm; }
  .head .facts { text-align: right; font-size: 9pt; color: var(--ink-soft); white-space: nowrap; }
  .head .facts b { color: var(--ink); }
  .sub { color: var(--ink-soft); font-size: 10pt; margin-top: 1mm; }

  .counts { display: flex; flex-wrap: wrap; gap: 6px; margin: 2mm 0 0; }
  .pill { font-size: 8.5pt; font-weight: 700; padding: 1px 8px; border-radius: 10px;
    border: 1pt solid var(--line); }
  .pill .n { font-variant-numeric: tabular-nums; }

  .hyp { background: #f5f7f9; border: 1pt solid var(--line); border-radius: 6px;
    padding: 3mm 4mm; margin: 3mm 0; }
  .hyp ul { margin: 0; padding-left: 5mm; }
  .hyp li { margin: 0 0 .8mm; font-size: 8.7pt; color: var(--ink-soft); }

  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 2.2mm 2mm; border-bottom: 1pt solid #e5e9ee; vertical-align: top; }
  th { font-size: 7.6pt; text-transform: uppercase; letter-spacing: .5px; color: var(--ink-soft);
    border-bottom: 1pt solid #000; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .tsum td { font-size: 9pt; }
  .tsum tr.serre td { background: #fff8e8; }
  .tsum tr.bad td { background: #fdece9; }

  .badge { display: inline-block; padding: 0 6px; border-radius: 3px; font-size: 8pt;
    font-weight: 700; color: #fff; letter-spacing: .3px; }
  .v-ok { background: #1f8f4e; }
  .v-warn { background: #b7791f; }
  .v-bad { background: #b3261e; }
  .v-unk { background: #64748b; }
  .cat { display: inline-block; padding: 0 5px; border-radius: 3px; font-size: 7.5pt;
    font-weight: 700; color: #fff; }
  .cat-vfr { background: #1f6b3a; } .cat-mvfr { background: #35618e; }
  .cat-ifr { background: #b3261e; } .cat-lifr { background: #6b1f6b; }

  .margin-ok { color: #1f8f4e; font-weight: 700; }
  .margin-tight { color: #b7791f; font-weight: 700; }
  .margin-bad { color: #b3261e; font-weight: 700; }
  .flag { color: #b3261e; font-weight: 700; }

  /* fiches détaillées */
  .card { border: 1pt solid var(--line); border-radius: 7px; padding: 3mm 4mm; margin: 3mm 0;
    break-inside: avoid; }
  .card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 6mm;
    border-bottom: 1pt solid #e5e9ee; padding-bottom: 1.5mm; margin-bottom: 2mm; }
  .card-head .who b { font-size: 12pt; }
  .card-head .dist { font-size: 9pt; color: var(--ink-soft); white-space: nowrap; }
  .cond { font-size: 8.6pt; color: var(--ink-soft); margin-bottom: 1.5mm; }
  .cond b { color: var(--ink); }
  .rwy-tbl td, .rwy-tbl th { padding: 1.6mm 2mm; }
  .rwy-tbl .op { color: var(--ink-soft); font-size: 8pt; }
  .wx { font-size: 8.6pt; margin-top: 2mm; }
  .wx .raw { font-family: "SF Mono", Menlo, monospace; font-size: 8.2pt; color: #333;
    background: #f5f7f9; padding: 1px 4px; border-radius: 3px; }
  .links { margin-top: 2mm; font-size: 8.6pt; }

  footer { margin-top: 8mm; padding-top: 2mm; border-top: 1.5pt solid #000; font-size: 8pt;
    color: var(--ink-soft); }
  footer .disc { font-weight: 700; color: var(--ink); }

  @media print {
    body { padding: 0; font-size: 10pt; }
    @page { size: A4; margin: 10mm; }
    a { color: inherit; text-decoration: none; }
  }
</style>

<div class="head">
  <div>
    <h1>{{ view.doc_label }}</h1>
    <div class="sub">
      Autour de <b>{{ view.reference_icaos | join(' / ') }}</b>
      {% if view.reference_names %}<span class="muted">— {{ view.reference_names | join(', ') }}</span>{% endif %}
      · rayon {{ view.radius_nm }} NM
    </div>
    <div class="counts">
      {% if view.counts.get('OK') %}<span class="pill"><span class="badge v-ok">OK</span> <span class="n">{{ view.counts['OK'] }}</span> posables</span>{% endif %}
      {% if view.counts.get('SERRÉ') %}<span class="pill"><span class="badge v-warn">SERRÉ</span> <span class="n">{{ view.counts['SERRÉ'] }}</span></span>{% endif %}
      {% if view.counts.get('INSUFFISANT') %}<span class="pill"><span class="badge v-bad">INSUFF.</span> <span class="n">{{ view.counts['INSUFFISANT'] }}</span></span>{% endif %}
      {% if view.counts.get('INCONNU') %}<span class="pill"><span class="badge v-unk">?</span> <span class="n">{{ view.counts['INCONNU'] }}</span> à vérifier</span>{% endif %}
    </div>
  </div>
  <div class="facts">
    Avion <b>{{ view.registration }}</b><br>
    <span class="muted">{{ view.aircraft_name }}</span><br>
    Généré <b class="mono">{{ view.generated_dual }}</b><br>
    <span class="muted">heures {{ view.display_timezone }}</span>
  </div>
</div>

<div class="hyp">
  <b class="small">Hypothèses de calcul</b>
  <ul>
    {% for n in view.notes %}<li>{{ n }}</li>{% endfor %}
  </ul>
</div>

{# ===================== SYNTHÈSE ===================== #}
<h2>Synthèse — {{ view.fields | length }} terrains</h2>
<table class="tsum">
  <tr>
    <th>Terrain</th><th class="num">Dist.</th><th class="num">Cap°M</th><th class="num">Alt.</th>
    <th>Piste + longue</th><th>Atterrissage</th><th>Décollage</th><th>Vent / trav.</th><th>Météo</th><th>Verdict</th>
  </tr>
  {% for f in view.fields %}
  <tr class="{% if f.verdict == 'SERRÉ' %}serre{% elif f.verdict == 'INSUFFISANT' %}bad{% endif %}">
    <td><b class="mono">{{ f.icao }}</b><br><span class="small muted">{{ f.name }}</span></td>
    <td class="num">{{ f.distance_nm }}<br><span class="small muted">NM</span></td>
    <td class="num mono">{{ '%03d' % f.bearing_mag }}</td>
    <td class="num">{{ f.elevation_ft }}<br><span class="small muted">ft</span></td>
    <td>{% if f.longest_runway_m %}{{ f.longest_runway_m }} m{% else %}<span class="muted">—</span>{% endif %}</td>
    <td>{% if f.best_landing %}<span class="mono small">{{ f.best_landing.runway_ident }}</span>
        {{ f.best_landing.required_m }}/{{ f.best_landing.available_m }} m<br>
        <span class="{% if not f.best_landing.ok %}margin-bad{% elif f.best_landing.margin_pct < 20 %}margin-tight{% else %}margin-ok{% endif %}">{{ '%+.0f' % f.best_landing.margin_pct }}%</span>
        {% else %}<span class="muted">—</span>{% endif %}</td>
    <td>{% if f.best_takeoff %}<span class="mono small">{{ f.best_takeoff.runway_ident }}</span>
        {{ f.best_takeoff.required_m }}/{{ f.best_takeoff.available_m }} m<br>
        <span class="{% if not f.best_takeoff.ok %}margin-bad{% elif f.best_takeoff.margin_pct < 20 %}margin-tight{% else %}margin-ok{% endif %}">{{ '%+.0f' % f.best_takeoff.margin_pct }}%</span>
        {% else %}<span class="muted">—</span>{% endif %}</td>
    <td class="small">{% if f.wind_speed is not none %}
        {% if f.wind_dir is not none %}{{ '%03d' % f.wind_dir }}°{% else %}VRB{% endif %}/{{ f.wind_speed }}kt<br>
        {% if f.xw_kt is not none %}trav. <b class="{% if f.crosswind_over_demo %}flag{% endif %}">{{ f.xw_kt }}kt</b> {{ f.xw_arrow }} <span class="muted mono">{{ f.xw_rwy }}</span>{% endif %}
        {% else %}<span class="muted">—</span>{% endif %}</td>
    <td>{% if f.flight_category %}<span class="cat cat-{{ f.flight_category | lower }}">{{ f.flight_category }}</span>{% if f.metar_is_proxy %} <span class="small muted">{{ f.metar_station }} {{ f.metar_distance_nm }}NM</span>{% endif %}{% else %}<span class="muted">—</span>{% endif %}</td>
    <td><span class="badge {{ f.verdict_class }}">{{ f.verdict_label }}</span></td>
  </tr>
  {% endfor %}
</table>
<p class="small muted" style="margin-top:2mm">Atterrissage / décollage : distance <b>requise / disponible</b> (franchissement 15 m, corrigée) et <b>marge</b> = (dispo − requis) / dispo. Verdict = faisabilité de l'ATTERRISSAGE (≥ 20 % de marge → posable, &lt; 20 % → serré, marge négative → insuffisant).</p>

{# ===================== FICHES ===================== #}
<h2>Fiches par terrain</h2>
{% for f in view.fields %}
<div class="card">
  <div class="card-head">
    <div class="who"><b class="mono">{{ f.icao }}</b> {{ f.name }}
      <span class="badge {{ f.verdict_class }}">{{ f.verdict_label }}</span></div>
    <div class="dist">{{ f.distance_nm }} NM · cap <b class="mono">{{ '%03d' % f.bearing_mag }}°M</b>
      <span class="muted">({{ '%03d' % f.bearing_true }}°V)</span> depuis {{ f.from_icao }}</div>
  </div>

  <div class="cond">
    Alt. terrain <b>{{ f.elevation_ft }} ft</b> · alt-pression <b>{{ f.pa_ft }} ft</b>
    · temp <b>{{ f.temp_c }} °C</b>{% if f.temp_is_isa %} <span class="muted">(ISA, pas d'obs.)</span>{% endif %}
    {% if f.qnh %} · QNH <b>{{ f.qnh }}</b>{% endif %}
    {% if f.wind_speed is not none %} · vent
      {% if f.wind_dir is not none %}{{ '%03d' % f.wind_dir }}°{% else %}VRB{% endif %}/{{ f.wind_speed }} kt{% if f.wind_gust %} raf. {{ f.wind_gust }}{% endif %}{% endif %}
    {% if f.xw_kt is not none %} · traversier max <b class="{% if f.crosswind_over_demo %}flag{% endif %}">{{ f.xw_kt }} kt</b>{% if f.crosswind_over_demo and view.demo_xw %} <span class="flag">&gt; démontré {{ view.demo_xw }} kt</span>{% endif %}{% endif %}
  </div>

  <table class="rwy-tbl">
    <tr><th>Piste</th><th>Long.</th><th>Revêt.</th><th class="num">Vent face</th>
      <th>Atterrissage (roul. / 15 m)</th><th>Décollage (roul. / 15 m)</th></tr>
    {% for r in f.runways %}
    <tr>
      <td class="mono">{{ r.ident }}</td>
      <td class="num">{% if r.length_m %}{{ r.length_m }} m{% else %}<span class="muted">?</span>{% endif %}</td>
      <td class="small">{% if r.is_paved == false %}herbe{% elif r.surface %}{{ r.surface }}{% else %}—{% endif %}</td>
      <td class="num small">{{ r.headwind_kt }} kt</td>
      <td>{% if r.landing %}<span class="op">{{ r.landing.roll_m }} / {{ r.landing.over15_m }} m</span> ·
          <span class="{% if not r.landing.ok %}margin-bad{% elif r.landing.margin_pct < 20 %}margin-tight{% else %}margin-ok{% endif %}">{{ '%+.0f' % r.landing.margin_pct }}%</span>
          {% else %}<span class="muted">longueur inconnue</span>{% endif %}</td>
      <td>{% if r.takeoff %}<span class="op">{{ r.takeoff.roll_m }} / {{ r.takeoff.over15_m }} m</span> ·
          <span class="{% if not r.takeoff.ok %}margin-bad{% elif r.takeoff.margin_pct < 20 %}margin-tight{% else %}margin-ok{% endif %}">{{ '%+.0f' % r.takeoff.margin_pct }}%</span>
          {% else %}<span class="muted">—</span>{% endif %}</td>
    </tr>
    {% endfor %}
  </table>

  <div class="wx">
    {% if f.metar_raw %}<b>METAR</b>{% if f.metar_is_proxy %} <span class="muted">(voisin {{ f.metar_station }}, {{ f.metar_distance_nm }} NM — pas d'obs. sur le terrain)</span>{% endif %}{% if f.metar_age %} <span class="muted">· {{ f.metar_age }}</span>{% endif %}
      <div class="raw">{{ f.metar_raw }}</div>{% endif %}
    {% if f.taf_raw %}<div style="margin-top:1.5mm"><b>TAF</b>{% if f.taf_is_proxy %} <span class="muted">(voisin {{ f.taf_station }})</span>{% endif %}
      <div class="raw">{{ f.taf_raw }}</div></div>{% endif %}
    {% if not f.metar_raw and not f.taf_raw %}<span class="muted">Pas de météo rattachable.</span>{% endif %}
  </div>

  <div class="links"><a href="{{ f.vac_url }}" target="_blank" rel="noopener">Carte VAC {{ f.icao }} (SIA) ↗</a></div>
</div>
{% endfor %}

<footer>
  <p class="disc">AIDE À LA PRÉPARATION — ne remplace pas l'étude des cartes VAC officielles ni le jugement du commandant de bord.</p>
  <p>Performances calculées par interpolation des tables du manuel de vol (jamais d'extrapolation hors table) ·
    déclinaison magnétique {{ view.variation_deg }}° · heures locales {{ view.display_timezone }}.</p>
</footer>
